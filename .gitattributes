# Normalize all text files and ensure LF line endings in the repository
* text=auto eol=lf

# Explicitly set common text file types to LF
*.sh text eol=lf
*.md text eol=lf
*.go text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.txt text eol=lf

# Treat common binary file types as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.jar binary
*.exe binary
*.bin binary

# Ensure any editor backup/temp files are not normalized (keep as binary)
*.swp binary
*.swo binary
*.DS_Store binary
